# -----------------------------
# Next.js (frontend / proxy)
# -----------------------------
# Used by src/app/api/* proxy routes (server-side).
API_BASE_URL="http://localhost:8800/api"
BACKEND_URL="http://127.0.0.1:8800"

# Used by client-side services (already present in the project).
NEXT_PUBLIC_API_BASE_URL="http://localhost:8800/api"

# Upload utility base (client-side). Default is "/api" (Next.js route handlers).
# To bypass Next.js and hit Express directly, set:
# NEXT_PUBLIC_UPLOAD_API_BASE="http://localhost:8800/api"
NEXT_PUBLIC_UPLOAD_API_BASE="/api"

# When true, the frontend will try the presigned S3 flow first (and falls back to multipart if presign is unavailable).
NEXT_PUBLIC_USE_PRESIGNED_UPLOADS="false"

# -----------------------------
# Express backend
# -----------------------------
PORT="8800"
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Storage: "local" (filesystem) or "s3" (OVH Object Storage / S3 compatible)
STORAGE_DRIVER="local"

# Presigned uploads (S3 only): when true, enables /api/uploads/presign + /api/uploads/confirm
USE_PRESIGNED_UPLOADS="false"

# Local uploads
UPLOADS_DIR="./uploads"
PUBLIC_BASE_URL="http://localhost:8800"

# -----------------------------
# Database (MySQL)
# -----------------------------
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="studio_alchemic"

# -----------------------------
# S3 / OVH Object Storage (only when STORAGE_DRIVER="s3")
# -----------------------------
S3_ENDPOINT="https://s3.<region>.io.cloud.ovh.net"
S3_BUCKET="your-bucket"
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."
S3_REGION="us-east-1"

# Optional: if set, returned public URLs will use this base (recommended)
PUBLIC_CDN_BASE_URL=""

# S3 compat tuning
S3_FORCE_PATH_STYLE="true"
S3_KEY_PREFIX=""
S3_ACL=""
S3_PRESIGN_EXPIRES_SECONDS="600"

